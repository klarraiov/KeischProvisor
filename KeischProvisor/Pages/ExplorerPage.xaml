<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KeischProvisor.Pages.ExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KeischProvisor.Pages"
    xmlns:controls="using:KeischProvisor.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Dense row style: the default ListViewItem min-height (~40px) is far too tall
             for a data explorer. Reset padding/min-height so a row is the content height. -->
        <Style x:Key="DenseListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ListViewItemPresenter
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentMargin="{TemplateBinding Padding}"
                            CheckMode="Inline"
                            SelectionCheckMarkVisualEnabled="False"
                            SelectedBackground="{ThemeResource ListViewItemBackgroundSelected}"
                            SelectedPointerOverBackground="{ThemeResource ListViewItemBackgroundSelectedPointerOver}"
                            SelectedPressedBackground="{ThemeResource ListViewItemBackgroundSelectedPressed}"
                            PointerOverBackground="{ThemeResource ListViewItemBackgroundPointerOver}"
                            PressedBackground="{ThemeResource ListViewItemBackgroundPressed}"
                            DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                            DragOpacity="{ThemeResource ListViewItemDragThemeOpacity}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="MenuBarGrid" Grid.Row="0" Margin="0 -8 0 -8" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- leftside -->
            <MenuBar Grid.Row="0" Grid.Column="0">
                <MenuBarItem x:Uid="MainPage_MenuFile" Title="File">
                    <MenuFlyoutItem x:Uid="MainPage_MenuFileOpen" Text="Open" Click="CommandOpenButton_Click"/>
                    <MenuFlyoutItem x:Uid="MainPage_MenuFileSave" Text="Save" />
                    <MenuFlyoutItem x:Uid="MainPage_MenuFileExit" Text="Exit" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MainPage_MenuEdit" Title="Edit">
                    <MenuFlyoutItem x:Uid="MainPage_MenuEditCut" Text="Cut" />
                    <MenuFlyoutItem x:Uid="MainPage_MenuEditCopy" Text="Copy" />
                    <MenuFlyoutItem x:Uid="MainPage_MenuEditPaste" Text="Paste" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MainPage_MenuView" Title="View">
                    <ToggleMenuFlyoutItem x:Name="MainPage_StatusBarToggleMenuFlyoutItem" x:Uid="MainPage_MenuViewStatusBar" Text="Status bar" Click="StatusBarToggleMenuFlyoutItem_Click"/>
                </MenuBarItem>
            </MenuBar>

            <!-- rightside -->
            <Button Height="32" Margin="0 0 4 0" Grid.Row="0" Grid.Column="1" Background="Transparent" BorderBrush="Transparent" Click="SettingsButton_Click" >
                <Grid>
                    <FontIcon FontSize="14" Glyph="&#xe713;"/>
                </Grid>
            </Button>
        </Grid>

        <!-- ===== Toolbar: global header info ===== -->
        <Grid Grid.Row="1" Padding="12 8 12 8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border CornerRadius="4" Padding="8 2 8 2"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="SignatureText" Text="—" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock x:Name="BuildText" Text="—" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderCountText" Text="—" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="ChecksumText" Text="—" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- The open file's path lives in the app title bar, not here. -->
            <Button Grid.Column="2" x:Name="ValidationButton" Content="Checks" FontSize="12"
                    Padding="10 4 10 4" Click="ValidationButton_Click"/>
        </Grid>

        <!-- ===== Two-pane body ===== -->
        <Grid Grid.Row="2" x:Name="PaneRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="380" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: tree.
                 The caption row and every data row size their cells from the SAME
                 TableMetrics object, so a divider drag updates both without any mirroring
                 step. Each caption cell is a container whose Width equals the width its data
                 cells bind to, which is what keeps the two grids in lock step. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12 4 8 4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="{x:Bind Metrics.TreeNameWidth, Mode=OneWay}">
                        <TextBlock Text="Name" VerticalAlignment="Center"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <controls:ColumnGrip Canvas.ZIndex="10" Width="7" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                             DragDelta="TreeNameGrip_DragDelta"
                                             ToolTipService.ToolTip="Drag to resize the Name column"/>
                    </Grid>

                    <Grid Grid.Column="1" Width="{x:Bind Metrics.TreeOffsetWidth, Mode=OneWay}">
                        <TextBlock Text="Offset" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <controls:ColumnGrip Canvas.ZIndex="10" Width="7" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                             DragDelta="TreeOffsetGrip_DragDelta"
                                             ToolTipService.ToolTip="Drag to resize the Offset column"/>
                    </Grid>

                    <Grid Grid.Column="2" Width="{x:Bind Metrics.TreeSubsWidth, Mode=OneWay}">
                        <TextBlock Text="Subs" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <controls:ColumnGrip Canvas.ZIndex="10" Width="7" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                             DragDelta="TreeSubsGrip_DragDelta"
                                             ToolTipService.ToolTip="Drag to resize the Subs column"/>
                    </Grid>
                </Grid>

                <ListView Grid.Row="1" x:Name="NodeListView"
                          ItemsSource="{x:Bind Nodes}"
                          SelectionMode="Single"
                          SelectionChanged="NodeListView_SelectionChanged"
                          ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:NodeRow">
                            <Grid Height="24" Padding="12 0 8 0" DoubleTapped="NodeRow_DoubleTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Name cell: indent, glyph, index and label all stay inside the
                                     fixed column so long paths trim instead of pushing the
                                     Offset/Subs columns around. -->
                                <Grid Grid.Column="0" Width="{x:Bind Metrics.TreeNameWidth, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="{x:Bind IndentWidth}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Glyph}" FontSize="11" Opacity="0.7"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               VerticalAlignment="Center" Width="16" TextAlignment="Center"
                                               Tapped="NodeRow_GlyphTapped"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Label}" FontSize="11" Opacity="0.55"
                                               VerticalAlignment="Center" Width="34"
                                               Visibility="{x:Bind LabelVisibility}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Name}" FontSize="12.5"
                                               Margin="4,0,6,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <!-- A cell that needs a text inset must be a container sized by the
                                     metric with the inset on the inner TextBlock. Putting both
                                     Width and Margin on the TextBlock itself makes its footprint
                                     Width+Margin, so that column ends up wider than its header
                                     and the two rows drift apart by exactly the margin. -->
                                <Grid Grid.Column="1" Width="{x:Bind Metrics.TreeOffsetWidth, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind OffsetText}" FontSize="11"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               FontFamily="Cascadia Mono, Consolas, Courier New, Monospace"
                                               Opacity="0.7" IsTextSelectionEnabled="True"/>
                                </Grid>
                                <Grid Grid.Column="2" Width="{x:Bind Metrics.TreeSubsWidth, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind SubCountText}" FontSize="11"
                                               Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Pane divider. A GridSplitter is the right tool here: both sides are real
                 grid columns of this two-pane grid, so the toolkit can resize them directly
                 with no data rows to keep in sync. PreviousAndNext targets the tree column
                 (pixel) and the detail column (star); the toolkit only writes the non-star
                 side, so the detail pane keeps absorbing the remaining width. The MinWidth
                 values (220 / 320) are the clamp. -->
            <toolkit:GridSplitter Grid.Column="1" MinWidth="0" MinHeight="0" IsTabStop="False"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  Background="Transparent" Foreground="Transparent"/>

            <!-- Right: detail.
                 Deliberately NOT wrapped in a ScrollViewer. A ScrollViewer measures its child
                 with infinite height, which destroys star sizing: the 2*/3* rows below would
                 collapse to content height, and any MaxHeight bound to the viewport would become
                 infinite and stop constraining. With the pane bounded, the two tables share the
                 available height and each scrolls its own rows instead. -->
            <!-- RowSpacing stays 0 and every gap is a bottom Margin on the section itself.
                 Grid.RowSpacing applies between every pair of rows regardless of their height,
                 so a collapsed row kept contributing a gap and a hidden divider row doubled the
                 space between the panes. Margins travel with their section instead, which keeps
                 the spacing identical no matter what is folded. -->
            <Grid Grid.Column="2" x:Name="DetailRoot" Padding="16 8 16 12" RowSpacing="0">
                    <!-- No ChildrenTransitions here, and that is deliberate.
                         RepositionThemeTransition looked like the natural fit for expand/collapse,
                         but it only animates each child's render offset: the row heights snap to
                         their final values immediately while the sections slide for a few hundred
                         milliseconds. A Grid does not clip its children to their slots, so the
                         travelling section is painted over its neighbour and the two appear
                         superimposed for the length of the animation.
                         Layout here is therefore instantaneous, and the section that appears fades
                         in over its already-correct bounds instead. -->
                    <!-- No MinHeight here on purpose. A RowDefinition MinHeight outranks an
                         assigned Height of 0, so a collapsed section would still reserve space
                         and the split would appear to remain. The minimums that keep a pane
                         usable live in the divider handler as MinPaneHeight instead. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="FieldsRow" Height="2*"/>
                        <RowDefinition x:Name="DetailDividerRow" Height="10"/>
                        <RowDefinition x:Name="HexRowDefinition" Height="3*"/>
                    </Grid.RowDefinitions>

                    <!-- A. identity bar -->
                    <StackPanel Grid.Row="0" x:Name="IdentityPanel" Spacing="2" Margin="0,0,0,10">
                        <TextBlock x:Name="IdentityTitle" Text="No file loaded" FontSize="20" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="IdentitySubtitle" Text="Open an rpf.cache file to begin."
                                   FontSize="12" Opacity="0.6" IsTextSelectionEnabled="True"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- B. summary (interpreted values).
                         Every section uses the same shape: one Grid, an Auto row holding the
                         clickable caption, and the body beneath it. Keeping the three panels
                         structurally identical means a collapse moves each one as a single
                         unit and no section needs per-object spacing to line up. -->
                    <Grid Grid.Row="1" x:Name="SummaryPanel" RowSpacing="0" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" x:Name="SummaryHeaderButton"
                                Click="SummaryHeader_Click"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                AutomationProperties.Name="Toggle Summary"
                                ToolTipService.ToolTip="Show or hide the Summary section">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="SummaryChevron" Glyph="&#xE70D;" FontSize="9"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Summary" Style="{StaticResource SectionHeaderStyle}"/>
                            </StackPanel>
                        </Button>
                        <!-- Padding 0 matches the table sections, whose caption band sits flush
                             under the section header. Any inner padding here would push the first
                             summary row further from its header than the tables do. -->
                        <Border Grid.Row="1" x:Name="SummaryContent" CornerRadius="6" Padding="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid x:Name="SummaryGrid" ColumnSpacing="12" RowSpacing="3"
                                  Padding="10 5 8 5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- C. raw field table.
                         Deliberately the same ListView + Grid construction as the sidebar: one
                         visual language, no extra table chrome, virtualization preserved.
                         The caption collapses the table; the row still exists so the divider can
                         hand the freed height to the hex viewer. -->
                    <Grid Grid.Row="2" x:Name="FieldsPanel" RowSpacing="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" x:Name="FieldsHeaderButton"
                                Click="FieldsHeader_Click"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                AutomationProperties.Name="Toggle Raw Fields"
                                ToolTipService.ToolTip="Show or hide the Raw Fields section">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="FieldsChevron" Glyph="&#xE70D;" FontSize="9"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Raw Fields" Style="{StaticResource SectionHeaderStyle}"/>
                            </StackPanel>
                        </Button>

                        <Border Grid.Row="1" x:Name="FieldsContent" CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Shown only before a file is loaded, so the section is never an
                                     empty box. -->
                                <TextBlock Grid.Row="1" x:Name="PlaceholderFieldText"
                                           Text="Open an rpf.cache file to inspect its fields."
                                           FontSize="12" Opacity="0.5" Margin="12,10,12,10"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>

                                <Grid Grid.Row="0" Padding="10 5 8 5"
                                      Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="{x:Bind Metrics.FieldOffsetWidth, Mode=OneWay}">
                                        <TextBlock Text="Offset" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:ColumnGrip Canvas.ZIndex="10" Width="7" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                                             DragDelta="FieldOffsetGrip_DragDelta"
                                                             ToolTipService.ToolTip="Drag to resize the Offset column"/>
                                    </Grid>

                                    <Grid Grid.Column="1" Width="{x:Bind Metrics.FieldNameWidth, Mode=OneWay}">
                                        <TextBlock Text="Field" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:ColumnGrip Canvas.ZIndex="10" Width="7" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                                             DragDelta="FieldNameGrip_DragDelta"
                                                             ToolTipService.ToolTip="Drag to resize the Field column"/>
                                    </Grid>

                                    <Grid Grid.Column="2" Width="{x:Bind Metrics.FieldTypeWidth, Mode=OneWay}">
                                        <TextBlock Text="Type" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:ColumnGrip Canvas.ZIndex="10" Width="7" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                                             DragDelta="FieldTypeGrip_DragDelta"
                                                             ToolTipService.ToolTip="Drag to resize the Type column"/>
                                    </Grid>

                                    <Grid Grid.Column="3" Width="{x:Bind Metrics.FieldHexWidth, Mode=OneWay}">
                                        <TextBlock Text="Hex" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:ColumnGrip Canvas.ZIndex="10" Width="7" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                                             DragDelta="FieldHexGrip_DragDelta"
                                                             ToolTipService.ToolTip="Drag to resize the Hex column"/>
                                    </Grid>

                                    <Grid Grid.Column="4" Width="{x:Bind Metrics.FieldDecWidth, Mode=OneWay}">
                                        <!-- No text inset here: the column is sized exactly by the
                                             metric, and a margin added inside it would shift the
                                             caption away from its data cells. -->
                                        <TextBlock Text="Dec" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:ColumnGrip Canvas.ZIndex="10" Width="7" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                                             DragDelta="FieldDecGrip_DragDelta"
                                                             ToolTipService.ToolTip="Drag to resize the Dec column"/>
                                    </Grid>

                                    <TextBlock Grid.Column="5" Width="{x:Bind Metrics.FieldStatusWidth, Mode=OneWay}"/>
                                </Grid>

                                <ListView Grid.Row="1" x:Name="FieldListView"
                                          ItemsSource="{x:Bind Fields}"
                                          SelectionMode="Single"
                                          SelectionChanged="FieldListView_SelectionChanged"
                                          ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:FieldRow">
                                            <Grid Height="23" Padding="10 0 8 0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Every data cell uses the same shape as its
                                                     caption cell: a Grid of exactly the column's
                                                     width, containing a TextBlock with the text
                                                     inset. A TextBlock carrying both Width and
                                                     Margin has a footprint of Width+Margin, which
                                                     made these columns wider than their captions
                                                     and forced compensating negative margins. -->
                                                <Grid Grid.Column="0" Width="{x:Bind Metrics.FieldOffsetWidth, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind OffsetText}" FontSize="11"
                                                               Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                                                               FontFamily="Cascadia Mono, Consolas, Courier New, Monospace"
                                                               IsTextSelectionEnabled="True"/>
                                                </Grid>

                                                <Grid Grid.Column="1" Width="{x:Bind Metrics.FieldNameWidth, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="12"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>

                                                <Grid Grid.Column="2" Width="{x:Bind Metrics.FieldTypeWidth, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Type}" FontSize="11"
                                                               Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6"/>
                                                </Grid>

                                                <Grid Grid.Column="3" Width="{x:Bind Metrics.FieldHexWidth, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind HexText}" FontSize="11"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                               FontFamily="Cascadia Mono, Consolas, Courier New, Monospace"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsTextSelectionEnabled="True"/>
                                                </Grid>

                                                <Grid Grid.Column="4" Width="{x:Bind Metrics.FieldDecWidth, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind DecText}" FontSize="11"
                                                               Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.75"
                                                               FontFamily="Cascadia Mono, Consolas, Courier New, Monospace"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsTextSelectionEnabled="True"/>
                                                </Grid>

                                                <!-- Status is a headerless column, so it is centred:
                                                     neither edge of the column implies an alignment
                                                     here the way it does for a labelled column. -->
                                                <TextBlock Grid.Column="5" Text="{x:Bind StatusGlyph}" FontSize="11"
                                                           Width="{x:Bind Metrics.FieldStatusWidth, Mode=OneWay}"
                                                           VerticalAlignment="Center" TextAlignment="Center"
                                                           Opacity="0.8"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Divider between the two tables: drag to trade height between them, the
                         way any docked-pane tool behaves. The rule is always drawn so the split
                         reads as adjustable instead of being discovered by accident. -->
                    <Grid Grid.Row="3" x:Name="DetailDividerHost">
                        <controls:ColumnGrip x:Name="DetailDivider"
                                             Orientation="Vertical"
                                             LineOpacity="0.9"
                                             DragStarted="DetailDivider_DragStarted"
                                             DragDelta="DetailDivider_DragDelta"
                                             DragCompleted="DetailDivider_DragCompleted"
                                             ToolTipService.ToolTip="Drag to resize the Raw Fields and Hex Viewer panes"
                                             DoubleTapped="DetailDivider_DoubleTapped"/>
                    </Grid>

                    <!-- D. hex viewer.
                         Position, raw bytes and ASCII are three distinct cells in three distinct
                         columns, so each is separately selectable and separately resizable
                         instead of forming one undifferentiated drag surface. -->
                    <Grid Grid.Row="4" x:Name="HexPanel" RowSpacing="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="HexHeaderButton"
                                    Click="HexHeader_Click"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    AutomationProperties.Name="Toggle Hex Viewer"
                                    ToolTipService.ToolTip="Show or hide the Hex Viewer section">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="HexChevron" Glyph="&#xE70D;" FontSize="9"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="HexHeader" Text="Bytes" Style="{StaticResource SectionHeaderStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" x:Name="CopyHexButton" Content="Copy all" FontSize="11"
                                    Padding="8 2 8 2" Margin="0 -4 0 0"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="CopyHexButton_Click" ToolTipService.ToolTip="Copy the whole hex dump"/>
                        </Grid>

                        <Border Grid.Row="1" x:Name="HexContent" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Shown only before a file is loaded. -->
                                <TextBlock Grid.Row="1" x:Name="PlaceholderHexText"
                                           Text="Byte-level contents appear here."
                                           FontSize="12" Opacity="0.5" Margin="12,10,12,10"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>

                                <Grid Grid.Row="0" Padding="10 5 8 5"
                                      Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="{x:Bind Metrics.HexPositionWidth, Mode=OneWay}">
                                        <TextBlock Text="Position" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:ColumnGrip Canvas.ZIndex="10" Width="7" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                                             DragDelta="HexPositionGrip_DragDelta"
                                                             ToolTipService.ToolTip="Drag to resize the Position column"/>
                                    </Grid>

                                    <Grid Grid.Column="1" Width="{x:Bind Metrics.HexRawWidth, Mode=OneWay}">
                                        <TextBlock Text="Raw Byte" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:ColumnGrip Canvas.ZIndex="10" Width="7" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                                             DragDelta="HexRawGrip_DragDelta"
                                                             ToolTipService.ToolTip="Drag to resize the Raw Byte column"/>
                                    </Grid>

                                    <Grid Grid.Column="2" Width="{x:Bind Metrics.HexAsciiWidth, Mode=OneWay}">
                                        <TextBlock Text="ASCII Text" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:ColumnGrip Canvas.ZIndex="10" Width="7" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                                             DragDelta="HexAsciiGrip_DragDelta"
                                                             ToolTipService.ToolTip="Drag to resize the ASCII Text column"/>
                                    </Grid>
                                </Grid>

                                <ListView Grid.Row="1" x:Name="HexListView"
                                          ItemsSource="{x:Bind HexRows}"
                                          SelectionMode="Single"
                                          ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:HexRow">
                                            <Grid Height="19" Padding="10 0 8 0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Same cell shape as the caption row above. -->
                                                <Grid Grid.Column="0" Width="{x:Bind Metrics.HexPositionWidth, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Position}" FontSize="12"
                                                               Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                                                               FontFamily="Cascadia Mono, Consolas, Courier New, Monospace"
                                                               IsTextSelectionEnabled="True"/>
                                                </Grid>

                                                <Grid Grid.Column="1" Width="{x:Bind Metrics.HexRawWidth, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Raw}" FontSize="12"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                               FontFamily="Cascadia Mono, Consolas, Courier New, Monospace"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsTextSelectionEnabled="True"/>
                                                </Grid>

                                                <Grid Grid.Column="2" Width="{x:Bind Metrics.HexAsciiWidth, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Ascii}" FontSize="12"
                                                               Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.9"
                                                               FontFamily="Cascadia Mono, Consolas, Courier New, Monospace"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsTextSelectionEnabled="True"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
            </Grid>

        </Grid>

        <!-- ===== Status bar ===== -->
        <Grid x:Name="StatusBarGrid" Grid.Row="3" Padding="12 4 12 4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" Text="Ready" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" x:Name="SelectionStatusText" Text="" FontSize="11"
                       VerticalAlignment="Center" Opacity="0.7"/>
        </Grid>
    </Grid>
</Page>
